# Fall Detection project - Git ignore rules

# Python virtual environments
.venv/
venv/
env/

# Video files are intentionally kept out of Git
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.flv
*.wmv
*.mpeg
*.mpg

# Large external archive exceeds GitHub's 100 MB single-file limit
dataset/expand/gmdcsa24/*.zip

# MCFD multi-view dataset (192 video files, ~GBs)
dataset/mcfd/

# LLM model files (GGUF weights, ~GBs)
models/llm/*.gguf

# Auto-generated debug outputs
results/debug_pose.png
results/qa_pose_3d/

# Generated 3D features (.npy files, ~MBs)
features/3d/

# New training checkpoints (large .pth files)
checkpoints/enhanced_3d_*/
checkpoints/enhanced_run_*/
checkpoints/run_*/

# Caches and generated bytecode
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.ipynb_checkpoints/

# IDE and OS files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
extract_log.txt

# Local/internal assistant state
**/.workbuddy/
.workbuddy/
